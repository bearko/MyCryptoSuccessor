{
  "name": "mycryptosuccessor",
  "version": "0.1.0",
  "description": "My Crypto Heroes の世界のランド「Lime」で、工房と店を営み、荒れ地を発掘して町を復興させる経営シミュレーション（非公式二次創作）",
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "predev": "node scripts/sync-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-assets.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "pretest": "node scripts/sync-assets.mjs",
    "test": "vitest run",
    "typecheck": "tsc",
    "island:sim": "vitest run tests/island-p1-sim.test.ts --silent=false --reporter=verbose",
    "island:audit": "vitest run tests/island-p1-audit.test.ts --silent=false --reporter=verbose",
    "i18n:check": "node scripts/i18n-check.mjs",
    "pixel:lint": "node scripts/pixel-lint.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bearko/MyCryptoSuccessor.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bearko/MyCryptoSuccessor/issues"
  },
  "homepage": "https://github.com/bearko/MyCryptoSuccessor#readme",
  "devDependencies": {
    "@fontsource/dotgothic16": "^5.3.1",
    "@fontsource/jersey-10": "^5.3.0",
    "@types/node": "^22.20.4",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "private": true,
  "type": "module"
}
